// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  coach
  athlete
  admin
}

// ── v2: categorias, assinaturas e planos (ver docs/superpowers/specs/2026-09-26-v2-categorias-assinaturas-design.md) ──

enum TrainingCategory {
  CORE
  LPO
  PERFORMANCE
}

// SHARED = um plano por categoria, igual pra todos os assinantes (Core/LPO); INDIVIDUAL = por aluno (Performance).
enum PlanScope {
  SHARED
  INDIVIDUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// Gateway ainda não decidido (Mercado Pago ou Asaas — spike na Rodada 4); por isso o schema é agnóstico.
enum PaymentGateway {
  MERCADO_PAGO
  ASAAS
}

enum PaymentStatus {
  pending
  paid
  overdue
}

enum SessionType {
  Mobility
  LPO
  Strength
  Gymnastics
  Metcon
  Endurance
  Core
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  passwordHash      String
  role              Role      @default(athlete)
  aiImportEnabled   Boolean   @default(true)
  /// Aceite dos termos/privacidade na inscrição pública (evidência LGPD): quando e qual versão.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  /// Consentimento para dados de saúde (LGPD Art. 11): null = não respondeu; false = não/retirou. Quando mudou por último.
  healthConsent     Boolean?
  healthConsentAt   DateTime?
  /// Conta anonimizada a pedido do titular (LGPD Art. 18): nome/e-mail trocados, senha inutilizável, token recusado.
  deletedAt         DateTime?
  /// Último login com senha (painel do admin, "uso por coach"). Registrado a partir de 2026-09-30; null = sem registro.
  lastLoginAt       DateTime?
  /// Última troca de senha: tokens emitidos ANTES disso são recusados (trocar a senha derruba as sessões abertas).
  passwordChangedAt DateTime?
  /// E-mail confirmado (link de confirmação ou criação de senha pelo link). null = não confirmado → não entra. Contas que já existiam
  /// antes de 2026-09-30 foram marcadas como confirmadas na migration (decisão do dono).
  emailVerifiedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  student           Student?           @relation("UserStudent")
  authTokens        AuthToken[]
  coachStudents     Student[]          @relation("CoachStudents")
  coachPlans        TrainingPlan[]     @relation("CoachPlans")
  workoutLogs       WorkoutLog[]
  exerciseLibrary   ExerciseLibrary[]  @relation("CoachLibrary")
  coachPayments     Payment[]          @relation("CoachPayments")
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  workoutSkips      WorkoutSkip[]
  hydrationLogs     HydrationLog[]
  calorieLogs       CalorieLog[]
  movements         Movement[]
  athleteMovements  Movement[]         @relation("AthleteMovements")
  personalRecords   PersonalRecord[]
  notifications     Notification[]
  workoutSessions   WorkoutSession[]
  subscriptionPlans SubscriptionPlan[] @relation("CoachSubscriptionPlans")
  coachContract     CoachContract?     @relation("CoachContract")
  coachProfile      CoachProfile?      @relation("CoachProfile")
  coachLeads        Lead[]             @relation("CoachLeads")
  coachTestimonials Testimonial[]      @relation("CoachTestimonials")
  coachFaqItems     FaqItem[]          @relation("CoachFaqItems")

  @@map("users")
}

model Student {
  id                String    @id @default(uuid())
  userId            String    @unique
  coachId           String
  goal              String?
  currentMonth      Int       @default(1)
  currentWeek       Int       @default(1)
  completionPercent Float     @default(0)
  /// Coletado só no momento do checkout de uma assinatura paga (nunca no cadastro) — exigido
  /// pelo gateway de pagamento (Asaas) pra criar o cliente que vai pagar.
  cpf               String?   @unique
  /// Id do "customer" do aluno no Asaas — criado uma vez, reusado entre trocas de plano.
  asaasCustomerId   String?
  /// Vínculo encerrado pelo coach ("desvincular") ou pela exclusão da conta: some das telas do coach e o aluno
  /// perde o acesso ao app. Os dados só são apagados/anonimizados a pedido do aluno (ou do admin).
  unlinkedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user          User           @relation("UserStudent", fields: [userId], references: [id], onDelete: Cascade)
  coach         User           @relation("CoachStudents", fields: [coachId], references: [id])
  trainingPlans TrainingPlan[]
  payments      Payment[]
  subscription  Subscription?

  @@map("students")
}

model TrainingPlan {
  id           String           @id @default(uuid())
  // Opcional desde a v2: plano SHARED (Core/LPO) pertence ao coach + categoria, não a um aluno.
  studentId    String?
  coachId      String
  category     TrainingCategory @default(PERFORMANCE)
  scope        PlanScope        @default(INDIVIDUAL)
  month        Int
  startDate    DateTime
  title        String
  published    Boolean          @default(false)
  /// Plano criado pela importação de PDF com IA (painel do admin). Registrado a partir de 2026-09-30.
  importedByAi Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach   User     @relation("CoachPlans", fields: [coachId], references: [id])
  weeks   Week[]

  @@map("training_plans")
}

model Week {
  id         String   @id @default(uuid())
  planId     String
  weekNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  plan TrainingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  days TrainingDay[]

  @@map("weeks")
}

model TrainingDay {
  id        String   @id @default(uuid())
  weekId    String
  dayOfWeek String
  dayIndex  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  week     Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("training_days")
}

model Session {
  id        String      @id @default(uuid())
  dayId     String
  name      String
  type      SessionType
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  day             TrainingDay      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  workoutSkips    WorkoutSkip[]
  workoutSessions WorkoutSession[]

  @@map("sessions")
}

model Exercise {
  id          String   @id @default(uuid())
  sessionId   String
  name        String
  youtubeUrl  String?
  sets        Int?
  reps        String?
  duration    String?
  restSeconds Int?
  loadPercent Float?
  coachNotes  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workoutLogs  WorkoutLog[]
  workoutSkips WorkoutSkip[]

  @@map("exercises")
}

model ExerciseLibrary {
  id           String   @id @default(uuid())
  coachId      String
  name         String
  youtubeUrl   String?
  /// Capa enviada pelo coach (Cloudinary). Sem ela, o card usa a miniatura do vídeo ou fica compacto.
  imageUrl     String?
  sets         Int?
  reps         String?
  duration     String?
  restSeconds  Int?
  loadPercent  Float?
  category     String?
  notes        String?
  /// Veio sozinho dos planos do coach (sincronização automática), não cadastrado à mão.
  autoImported Boolean  @default(false)
  /// Importado e depois excluído pelo coach: fica oculto (não volta na próxima sincronização).
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coach User @relation("CoachLibrary", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("exercise_library")
}

model Payment {
  id          String        @id @default(uuid())
  studentId   String
  coachId     String
  amount      Float
  description String?
  dueDate     DateTime
  paidAt      DateTime?
  status      PaymentStatus @default(pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  coach   User    @relation("CoachPayments", fields: [coachId], references: [id])

  @@map("payments")
}

model Message {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  content   String
  read      Boolean  @default(false)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  from User @relation("SentMessages", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedMessages", fields: [toId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model WorkoutLog {
  id              String   @id @default(uuid())
  exerciseId      String
  athleteId       String
  completedAt     DateTime @default(now())
  setsCompleted   Int
  durationSeconds Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  athlete  User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("workout_logs")
}

enum WorkoutSessionStatus {
  Completed
  Partial
}

model WorkoutSession {
  id             String               @id @default(uuid())
  sessionId      String
  athleteId      String
  startedAt      DateTime
  finishedAt     DateTime
  elapsedSeconds Int
  activeSeconds  Int
  status         WorkoutSessionStatus
  createdAt      DateTime             @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete User    @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
  @@index([sessionId])
  @@map("workout_sessions")
}

enum SkipReason {
  NoTime
  Injury
  Later
  Other
  /// Só o sistema grava: motivo de saúde removido quando o aluno retira o consentimento (LGPD Art. 8 §5).
  Withheld
}

enum SkipDecision {
  Postponed
  Abandoned
}

model WorkoutSkip {
  id         String       @id @default(uuid())
  exerciseId String?
  sessionId  String?
  athleteId  String
  reason     SkipReason
  note       String?
  decision   SkipDecision
  createdAt  DateTime     @default(now())

  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  session  Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete  User      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("workout_skips")
}

model HydrationLog {
  id        String   @id @default(uuid())
  athleteId String
  amountMl  Int
  loggedAt  DateTime @default(now())

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("hydration_logs")
}

model CalorieLog {
  id        String   @id @default(uuid())
  athleteId String
  kcal      Int
  loggedAt  DateTime @default(now())

  athlete User @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@map("calorie_logs")
}

/// Catálogo de movimentos pra registrar PR. Três origens, nunca mais de uma:
/// global (coachId e athleteId null — catálogo padrão, todo mundo vê), do coach (coachId —
/// o coach e os alunos dele veem) ou do atleta (athleteId — só ele vê).
model Movement {
  id        String   @id @default(uuid())
  name      String
  category  String
  coachId   String?
  athleteId String?
  createdAt DateTime @default(now())

  coach           User?            @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athlete         User?            @relation("AthleteMovements", fields: [athleteId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  @@index([athleteId])
  @@map("movements")
}

model PersonalRecord {
  id         String   @id @default(uuid())
  athleteId  String
  movementId String
  loadKg     Float?
  reps       Int?
  achievedAt DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  athlete  User     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@map("personal_records")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ── v2: assinaturas ─────────────────────────────────────────────────────────────

/// Plano de assinatura de um coach (Combo/Core/LPO/Free são só o padrão inicial — coach e admin editam).
model SubscriptionPlan {
  id          String             @id @default(uuid())
  coachId     String
  name        String
  description String?
  /// 0 = gratuito. Centavos pra não usar float com dinheiro.
  priceCents  Int                @default(0)
  /// O que o plano libera. Combo = as 3; Core = [CORE]; LPO = [LPO]; Free = o que o coach/admin configurarem.
  categories  TrainingCategory[]
  isFree      Boolean            @default(false)
  /// O que o Free libera além das categorias (sessões-amostra, vídeos de dúvida, histórico, chat...). Formato livre por ora.
  freeConfig  Json?
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  coach         User           @relation("CoachSubscriptionPlans", fields: [coachId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([coachId])
  @@map("subscription_plans")
}

/// Assinatura de um aluno (uma por aluno; trocar de plano = atualizar o plano).
model Subscription {
  id                    String             @id @default(uuid())
  studentId             String             @unique
  planId                String
  status                SubscriptionStatus @default(ACTIVE)
  startedAt             DateTime           @default(now())
  renewsAt              DateTime?
  canceledAt            DateTime?
  trialEndsAt           DateTime?
  /// Preenchidos só na Rodada 4 (gateway de cobrança).
  gateway               PaymentGateway?
  gatewaySubscriptionId String?
  /// % da plataforma usado no split desta assinatura no Asaas (gravado no checkout). O split é
  /// fixado na criação da assinatura — mudar o contrato depois não altera as já criadas.
  platformFeePercent    Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  gatewayPayments GatewayPayment[]

  @@index([planId])
  @@map("subscriptions")
}

/// Cada cobrança individual gerada pela assinatura recorrente no gateway (Asaas) — uma por ciclo.
/// Existe pra idempotência do webhook (nunca processar o mesmo pagamento duas vezes) e pra dar
/// visibilidade de cobranças passadas; nunca é criado/editado pelo aluno ou coach diretamente.
model GatewayPayment {
  id             String        @id @default(uuid())
  subscriptionId String
  asaasPaymentId String        @unique
  status         PaymentStatus @default(pending)
  amount         Float
  /// Valor líquido informado pelo Asaas (depois da taxa do gateway). null = ainda não informado.
  netValue       Float?
  dueDate        DateTime
  paidAt         DateTime?
  /// Link da fatura hospedada no Asaas (PIX/boleto/cartão) — pro aluno pagar.
  invoiceUrl     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("gateway_payments")
}

/// Registro mínimo de cada notificação recebida do gateway — só o necessário pra auditoria/
/// debug (id do evento, se foi processado). Nunca guarda o corpo cru (pode conter CPF/e-mail
/// do pagador — reter isso indefinidamente sem necessidade é o mesmo achado LGPD já corrigido
/// no AmoraRunning; aqui já nasce sem esse problema).
model WebhookLog {
  id             String    @id @default(uuid())
  provider       String    @default("ASAAS")
  event          String
  asaasPaymentId String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@map("webhook_logs")
}

/// Contrato do coach com a plataforma — SÓ o admin edita. Nunca exposto ao atleta.
model CoachContract {
  id                 String          @id @default(uuid())
  coachId            String          @unique
  /// Porcentagem da plataforma sobre cada cobrança, definida por contrato (ex.: 20.00).
  platformFeePercent Decimal         @default(0) @db.Decimal(5, 2)
  gateway            PaymentGateway?
  /// Referência da conta do coach no gateway (Asaas: walletId; MP: id do usuário). Segredo/token NUNCA aqui em claro.
  gatewayAccountRef  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  coach User @relation("CoachContract", fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_contracts")
}

/// Configurações globais da plataforma (linha única, id = 'singleton'). Editável só pelo admin.
model PlatformSettings {
  id                        String   @id @default("singleton")
  /// Quando false, o acesso NÃO é limitado pela assinatura (comportamento pré-v2). Liga-se na Rodada 3.
  enforceSubscriptionAccess Boolean  @default(false)
  updatedAt                 DateTime @updatedAt

  @@map("platform_settings")
}

// ── Landing page pública do coach ────────────────────────────────────────────

/// Perfil público do coach (1:1) — banner, bio, slug da URL. Só existe/aparece
/// depois que o coach configura e publica; visitante nunca cria conta aqui.
model CoachProfile {
  id        String  @id @default(uuid())
  coachId   String  @unique
  /// URL da página pública (/c/:slug) — único, formato validado no DTO (kebab-case).
  slug      String  @unique
  bio       String?
  bannerUrl String?
  published Boolean @default(false)

  /// Foto pessoal do coach (distinta do banner do hero) — seção "Sobre o coach".
  photoUrl         String?
  /// Frase de destaque do hero (ex.: "Treine com precisão tática..."). Null = usa o texto padrão do template.
  headline         String?
  /// Parágrafo de apoio abaixo do headline. Null = usa o texto padrão do template.
  subheadline      String?
  /// Citação em destaque do coach na seção "Sobre o coach".
  quote            String?
  /// Selo curto de credencial (ex.: "Semifinals CrossFit Games").
  achievementBadge String?
  yearsExperience  Int?
  athletesCount    Int?
  /// Métricas autodeclaradas pelo coach pra seção de depoimentos (0-100).
  npsScore         Int?
  completionRate   Float?
  whatsappNumber   String?
  /// Vídeo de demonstração (YouTube) — mesmo componente de embed já usado nos exercícios.
  videoUrl         String?
  /// Garantia OFERECIDA PELO COACH, além do arrependimento legal de 7 dias (CDC). Null = sem garantia extra.
  guaranteeDays    Int?
  guaranteeText    String?
  /// Suporte ao aluno (além do WhatsApp).
  supportEmail     String?
  supportHours     String?
  /// Textos editáveis da página (títulos, cards do "Como funciona", chamada final). Formato validado
  /// no DTO (PageCopyDto); campo ausente = texto padrão do template.
  pageCopy         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach User @relation("CoachProfile", fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

/// Depoimento de aluno, cadastrado manualmente pelo coach (não é um review verificado de um aluno real do sistema).
model Testimonial {
  id         String   @id @default(uuid())
  coachId    String
  authorName String
  authorRole String?
  rating     Int      @default(5)
  content    String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  coach User @relation("CoachTestimonials", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("testimonials")
}

model FaqItem {
  id        String   @id @default(uuid())
  coachId   String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  coach User @relation("CoachFaqItems", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("faq_items")
}

/// Contato enviado pelo formulário da landing page — vira notificação (+ e-mail) pro coach.
/// Não cria conta nem assinatura: é só um lead, o coach decide o que fazer por fora.
model Lead {
  id        String   @id @default(uuid())
  coachId   String
  name      String
  email     String
  phone     String?
  message   String?
  createdAt DateTime @default(now())

  coach User @relation("CoachLeads", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@map("leads")
}

/// Para que serve um link enviado por e-mail (decisões do dono, 2026-09-30).
enum AuthTokenPurpose {
  RESET_PASSWORD
  SET_PASSWORD
  VERIFY_EMAIL
}

/// Link de uso único enviado por e-mail (esqueci minha senha, crie sua senha, confirme seu e-mail). Guarda só o
/// SHA-256 do token — o token em si só existe no e-mail.
model AuthToken {
  id        String           @id @default(uuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}
